@inherits LayoutComponentBase
@inject IThemeService _themeService

<MudThemeProvider @ref="_mudThemeProvider" IsDarkMode="_themeService.IsDarkMode" Theme="_themeService.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <div class="gac-bg-glow gac-bg-glow-1"></div>
    <div class="gac-bg-glow gac-bg-glow-2"></div>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@((e) => ToggleDrawer())" />
        <MudSpacer />
        <div class="gac-app-icon mr-2">
            <MudIcon Icon="@Icons.Material.Filled.AcUnit" Style="color:#ffffff;" Size="Size.Small" />
        </div>
        <MudText Typo="Typo.h6">GREE AC Local Server</MudText>
        <MudSpacer />
        <MudIconButton
        Icon="@(_themeService.IsAutoMode ? Icons.Material.Filled.AutoMode : (_themeService.IsDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode))"
        Color="Color.Inherit" OnClick="@((e) => ToggleTheme())"
        title="@($"Toggle theme ({(_themeService.IsAutoMode ? "Auto mode" : (_themeService.IsDarkMode ? "Dark mode" : "Light mode"))})")" />
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

