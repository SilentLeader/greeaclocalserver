{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "blazorwasm",
            "request": "launch",
            "hosted": true,
            "program": "${workspaceFolder}/src/GreeACLocalServer.Api/bin/Debug/net10.0/GreeACLocalServer.Api.dll",
            "cwd": "${workspaceFolder}/src/GreeACLocalServer.Api",
            "browser": "chrome",
            "url": "http://localhost:5100",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "dotNetConfig": {
                "justMyCode": true,
                "logging": {
                    "moduleLoad": false
                }
            }
        },
        {
            "name": "Debug backend",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/GreeACLocalServer.Api/bin/Debug/net10.0/GreeACLocalServer.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/GreeACLocalServer.Api",
            "env": {
                "DOTNET_ENVIRONMENT": "Development",
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "preLaunchTask": "build",
            "justMyCode": true,
            "logging": {
                "moduleLoad": false
            }
        },
        {
            "name": "Docker: Attach to backend",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickRemoteProcess}",
            "preLaunchTask": "docker-debug-up",
            "pipeTransport": {
                "pipeProgram": "docker",
                "pipeArgs": [
                    "exec",
                    "-i",
                    "gree-ac-local-server-debug"
                ],
                "debuggerPath": "/vsdbg/vsdbg",
                "pipeCwd": "${workspaceFolder}",
                "quoteArgs": false
            },
            "sourceFileMap": {
                "/src": "${workspaceFolder}/src"
            },
            "justMyCode": true,
            "logging": {
                "moduleLoad": false
            },
            "postDebugTask": "docker-debug-down"
        },
        {
            "name": "Docker: Open UI in Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5100",
            "webRoot": "${workspaceFolder}/src/GreeACLocalServer.UI",
            "preLaunchTask": "docker-debug-wait"
        },
        {
            "name": "Watch",
            "type": "coreclr",
            "request": "launch",
            "program": "dotnet",
            "args": [
                "watch",
                "--project",
                ".",
                "--verbose"
            ],
            "cwd": "${workspaceFolder}/src/GreeACLocalServer.Api",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "preLaunchTask": "build"
        },
        {
            "name": "Attach",
            "type": "blazorwasm",
            "request": "attach",
            "cwd": "${workspaceFolder}/src/GreeACLocalServer.Api",
            "browser": "chrome",
            "url": "http://localhost:5100",
            "timeout": 30000
        }
    ],
    "compounds": [
        {
            "name": "Docker: Debug backend + UI",
            "configurations": [
                "Docker: Attach to backend",
                "Docker: Open UI in Chrome"
            ],
            "stopAll": true
        },
        {
            "name": "Debug with Hot Reload",
            "configurations": [
                "Watch",
                "Attach"
            ]
        },
        {
            "name": "Debug with Build",
            "configurations": [
                "Debug"
            ],
            "preLaunchTask": "build",
        }
    ]
}